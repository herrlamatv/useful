{
  "manifest_version": 3,
  "name": "enable-rightclick",
  "version": "1.1.0",
  "author": "herrlamatv",
  "description": "Unlocks right-click and text selection, switched on per site.",
  "permissions": ["scripting", "storage", "tabs"],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "enable-rightclick"
  },
  "background": {
    "service_worker": "background.js"
  }
}
